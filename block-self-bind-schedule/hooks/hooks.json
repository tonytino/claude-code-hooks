{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/remind.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(mcp__.+__(send_later|create_trigger|update_trigger)|CronCreate|ScheduleWakeup)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT\"/hooks/guard.sh",
            "statusMessage": "Checking for self-bind scheduling"
          }
        ]
      }
    ]
  }
}
